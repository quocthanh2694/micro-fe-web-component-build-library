{
	"workspaces": {
		"packages": [
			"packages/shop",
			"packages/container",
			"packages/ui-libs"
		]
	},
	"scripts": {
		"start": "lerna run --parallel start",
		"build": "lerna run build",
		"publish": "cd packages/ui-libs & yarn run publish:lib",
		"lerna-ls": "lerna ls --all",
		"deploy": "lerna run deploy",
		"deploy:staging": "lerna run deploy:staging",
		"serve": "lerna run --parallel serve",
		"clean": "lerna run --parallel clean"
	},
	"devDependencies": {
		"lerna": "7.0.2"
	},
	"dependencies": {
		"@babel/core": "^7.22.5"
	}
}